# Soroban Keeper Network - Keeper Bot v2
# Configuration for adaptive fee submission

# ============================================================================
# Adaptive Fee Configuration
# ============================================================================

# Maximum fee in stroops the operator will ever pay.
# The adaptive fee module will never submit a transaction with a fee exceeding
# this value, regardless of network congestion.
# Recommended: 10000 stroops for normal operations.
# Default: 10000
FEE_CEILING_STROOPS=10000

# Target fee percentile from recent network statistics.
# p10  = Pay more than 10% of recent transactions (ultra-low cost, risky)
# p50  = Pay more than 50% (median fee, moderate inclusion probability)
# p90  = Pay more than 90% (high inclusion probability, recommended)
# p99  = Pay more than 99% (extreme inclusion priority, expensive)
# Default: p90
FEE_PERCENTILE=p90

# Multiplier applied to the selected percentile fee.
# 1.0  = Exact percentile fee from network stats
# 1.1  = 10% above percentile (balance of inclusion and cost)
# 1.5+ = Aggressive fee bumping for high-priority transactions
# Default: 1.1
FEE_MULTIPLIER=1.1

# ============================================================================
# Soroban RPC Configuration
# ============================================================================

# Soroban RPC server URL for querying network conditions and submitting transactions
# Examples:
#   Testnet:  https://soroban-testnet.stellar.org
#   Mainnet:  https://soroban-mainnet.stellar.org
#   Local:    http://localhost:8000
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ============================================================================
# Network Configuration
# ============================================================================

# Stellar network to target
# Options: testnet, mainnet, standalone
# Default: testnet
NETWORK=testnet

# ============================================================================
# Keeper Configuration (TODO: expand as keeper-bot-v2 features are added)
# ============================================================================

# Stellar account secret key for signing transactions
# Format: A 56-character base32 string starting with S
# WARNING: Never commit this to version control. Use a secrets manager in production.
KEEPER_SECRET_KEY=

# Account ID for the keeper (optional, used for display/validation)
KEEPER_ACCOUNT_ID=

# Maximum concurrent task executions per round
# Default: 1
MAX_CONCURRENT_TASKS=1
# Soroban Keeper Bot v2 Configuration Template

# Network selection: testnet, futurenet, mainnet
NETWORK=testnet

# Deployed KeeperRegistry contract address (C...)
REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Secret Management Backend: env, vault, or aws_secrets_manager
SECRET_BACKEND=env

# Single signing account key (starts with S...)
KEEPER_SECRET_KEY=SBGWKM3CD4IL47QN6X54N6Y33T3JDNVI6AIJ6CD5IM47HG3IG4O36XCU

# Optional multi-account signing pool for concurrent transactions (comma-separated secret keys)
# If provided, supersedes KEEPER_SECRET_KEY
# SIGNING_KEY_POOL=SBGWKM3CD4IL47QN6X54N6Y33T3JDNVI6AIJ6CD5IM47HG3IG4O36XCU,SC...

# Vault or AWS Secrets Manager configuration (when SECRET_BACKEND is vault or aws_secrets_manager)
# VAULT_ADDR=http://127.0.0.1:8200
# AWS_SECRET_NAME=soroban/keeper/signing-keys

# Database URL for persistent task state storage (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keeper_bot_v2

# Concurrency limit within a single round. Must not exceed number of signing accounts in the pool!
MAX_CONCURRENT_TASKS=1

# Maximum tasks evaluated per polling round
MAX_TASKS_PER_ROUND=5

# Polling interval in milliseconds (must be >= 1000)
POLL_INTERVAL_MS=10000

# Minimum profit margin in stroops (1 XLM = 10,000,000 stroops).
MIN_PROFIT_MARGIN_STROOPS=0

# Maximum fee ceiling in stroops (safety ceiling against network fee surges)
FEE_CEILING_STROOPS=1000000

# Minimum accumulated balance before triggering automated withdrawal (in stroops)
WITHDRAW_THRESHOLD=10000000

# Retry configuration for transient errors
MAX_RETRIES=3
RETRY_BASE_MS=500

# Expire stale tasks to refund creators
EXPIRE_STALE_TASKS=true

# Development/testing simulation flag (simulates execution without actual off-chain worker)
SIMULATE_EXECUTION=false

# Metrics endpoint configuration
METRICS_ENABLED=true
METRICS_PORT=9090
